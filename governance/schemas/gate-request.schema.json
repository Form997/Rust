{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form997.github.io/Rust/governance/schemas/gate-request.schema.json",
  "title": "AL Shared Rulebook Gate Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "subsystem",
    "operation",
    "subject_type",
    "subject_sha256",
    "evaluated_at",
    "verifier_version",
    "evidence_refs"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subsystem": {
      "enum": [
        "compiler",
        "runtime",
        "ai",
        "training",
        "evaluation",
        "scientific",
        "release"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "subject_type": {
      "type": "string",
      "minLength": 1
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
