{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form997.github.io/Rust/governance/schemas/cross-system-control-matrix.schema.json",
  "title": "AL Cross-System Rulebook Control Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "status",
    "rulebook_authority",
    "decision_values",
    "evidence_levels",
    "subsystems",
    "unknowns_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "matrix_id": {
      "const": "AL-H0.2.10.1"
    },
    "status": {
      "enum": [
        "proposed",
        "owner_reviewed",
        "approved"
      ]
    },
    "rulebook_authority": {
      "type": "string",
      "minLength": 1
    },
    "decision_values": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ALLOW",
          "DENY",
          "REVIEW"
        ]
      },
      "minItems": 3,
      "maxItems": 3
    },
    "evidence_levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "name",
          "meaning",
          "limitations"
        ],
        "properties": {
          "level": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "boundary",
          "checks",
          "evidence",
          "failure_disposition",
          "control_ids",
          "mapping_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "failure_disposition": {
            "type": "string",
            "minLength": 1
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
            },
            "uniqueItems": true
          },
          "mapping_status": {
            "enum": [
              "mapped",
              "pending",
              "not_applicable"
            ]
          }
        }
      }
    },
    "unknowns_policy": {
      "const": "NOT_SET; do not infer or invent thresholds."
    }
  }
}
