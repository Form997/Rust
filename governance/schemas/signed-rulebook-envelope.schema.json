{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haidat.dev/al/schemas/signed-rulebook-envelope.schema.json",
  "title": "AL Signed Rulebook Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "key_id",
    "payload",
    "signature_base64"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
