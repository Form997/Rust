{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form997.github.io/Rust/governance/schemas/training-run-manifest.schema.json",
  "title": "AL AI Training Run Manifest",
  "description": "Reproducibility and governance manifest for a model training or fine-tuning run. It records pins and hashes but does not certify dataset rights or model quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "started_at",
    "rulebook",
    "metrics",
    "dataset",
    "code",
    "configuration",
    "random_seeds",
    "environment",
    "artifacts",
    "governance_review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^AL-TRN-[A-Z0-9-]+$",
      "minLength": 1
    },
    "run_type": {
      "enum": [
        "training",
        "fine_tuning",
        "evaluation",
        "data_preparation",
        "benchmark"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "bundle_checksum",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "bundle_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$",
          "minLength": 1
        },
        "status": {
          "enum": [
            "approved",
            "proposed",
            "evaluation_only"
          ]
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "version",
          "card_checksum"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^AL-MET-[A-Z0-9-]+$",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "card_checksum": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$",
            "minLength": 1
          }
        }
      }
    },
    "dataset": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "version",
          "content_checksum",
          "license_status",
          "provenance_record"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "content_checksum": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$",
            "minLength": 1
          },
          "license_status": {
            "enum": [
              "verified",
              "restricted",
              "unknown",
              "not_cleared"
            ]
          },
          "provenance_record": {
            "type": "string",
            "minLength": 1
          },
          "privacy_review": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$",
          "minLength": 1
        },
        "dirty_worktree": {
          "type": "boolean"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_checksum",
        "hyperparameters"
      ],
      "properties": {
        "config_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$",
          "minLength": 1
        },
        "hyperparameters": {
          "type": "object"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "random_seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "runtime",
        "hardware_profile"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "hardware_profile": {
          "enum": [
            "lite",
            "standard",
            "development",
            "training",
            "other"
          ]
        },
        "hardware_details": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "checksum"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "model",
              "checkpoint",
              "log",
              "evaluation_report",
              "dataset_snapshot",
              "other"
            ]
          },
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$",
            "minLength": 1
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "governance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reviewer",
        "notes"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "blocked"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_type": {
            "enum": [
              "training",
              "fine_tuning"
            ]
          }
        },
        "required": [
          "run_type"
        ]
      },
      "then": {
        "properties": {
          "rulebook": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "dataset": {
            "items": {
              "properties": {
                "license_status": {
                  "const": "verified"
                }
              }
            }
          },
          "governance_review": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ]
}
