{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haidat.dev/al/schemas/authorized-signers.schema.json",
  "title": "AL Authorized Rulebook Signers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "keys"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "principal_id",
          "role",
          "status",
          "public_key_base64"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "principal_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "const": "rulebook_authority"
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "public_key_base64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        }
      }
    }
  }
}
