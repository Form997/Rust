{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form997.github.io/Rust/governance/schemas/decision-record.schema.json",
  "title": "AL Governance Decision Record",
  "description": "Auditable record of a proposed or approved AL project decision and its supporting evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "title",
    "context",
    "decision",
    "status",
    "rulebook_version",
    "evidence",
    "impact",
    "approval",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^AL-DEC-[A-Z0-9-]+$",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option",
          "assessment"
        ],
        "properties": {
          "option": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "status": {
      "enum": [
        "proposed",
        "under_review",
        "approved",
        "rejected",
        "superseded",
        "revoked"
      ]
    },
    "rulebook_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AL-[A-Z0-9-]+$",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "description",
          "locator"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "risks",
        "rollback_plan"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "approver",
        "approved_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected",
            "revoked"
          ]
        },
        "approver": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
